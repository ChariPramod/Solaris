# Local CLI workspace (default; localhost only)
# GAUNTLET_PROJECT_ROOT=/absolute/path/to/Solaris
# GAUNTLET_PYTHON=/absolute/path/to/Solaris/.venv/bin/python

# Vercel deployment. Configure secrets in Vercel, never in git.
# GAUNTLET_STORAGE=vercel
# GAUNTLET_PUBLIC_ORIGIN=https://your-project.vercel.app
# GAUNTLET_ADMIN_KEY=<at least 32 random characters>
# BLOB_READ_WRITE_TOKEN=<private Blob store connection>
# GAUNTLET_SOURCE_REVISION=<published 40-character commit, defaults to VERCEL_GIT_COMMIT_SHA>
# SOLARI_API_KEY=<required for live evaluations>
# ANTHROPIC_API_KEY=<required for Claude>
# OPENAI_API_KEY=<required for OpenAI>
# Sandbox uses Vercel's deployment OIDC identity automatically.
